{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyFlowHub",
  "version": "0.2.0",
  "identifier": "com.yukin.easyflowhub",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "manager",
        "title": "EasyFlowHub",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "transparent": false,
        "alwaysOnTop": false,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "center": true
      },
      {
        "label": "launcher",
        "title": "EasyFlowHub Launcher",
        "width": 440,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "transparent": true,
        "alwaysOnTop": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**",
          "$RESOURCE/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "../../scriptmgr-go/scriptmgr.exe": "scriptmgr.exe"
    },
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QTIxOTdENUU5Njc4RTYKUldUbWVKWmVmUm1pK0Z6QzlLTFNPYW1LSUx0ajJEaElodU9Cak9BOXFjd2J2MkQ1ZkEzam5NZTEK",
      "endpoints": [
        "https://github.com/yukin371/easyflowhub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
